+from transformers import LogitsProcessor, LogitsProcessorList
+import spacy
+
+# Custom logits processor that guards against inf/nan logits in Mistral generation
+class NaNInfLogitsProcessor(LogitsProcessor):
+    """
+    Processor that filters out inf/nan values from logits before softmax.
+    This prevents CUDA errors during torch.multinomial when extreme logits cause invalid probabilities.
+    """
+    def __call__(self, input_ids, scores):
+        # Clamp extreme values to prevent overflow
+        scores = torch.clamp(scores, min=-100, max=100)
+        # Replace any remaining inf/nan with a very low score
+        scores = torch.where(torch.isnan(scores), torch.full_like(scores, -100.0), scores)
+        scores = torch.where(torch.isinf(scores), torch.full_like(scores, -100.0), scores)
+        return scores
+
+
+def safe_batch_decode(tokenizer, output_ids, skip_special_tokens=True, max_retries=3):
+    """
+    Safely decode token IDs with validation and clamping to prevent OverflowError.
+    
+    The Mistral model occasionally generates invalid token IDs (out of vocab range or negative)
+    which cause OverflowError during decode. This function:
+    1. Clamps token IDs to valid vocabulary range [0, vocab_size-1]
+    2. Replaces any remaining invalid tokens with the pad/unk token
+    3. Catches and handles decode errors gracefully
+    """
+    vocab_size = tokenizer.vocab_size
+    pad_token_id = tokenizer.pad_token_id if tokenizer.pad_token_id is not None else 0
+    
+    # Clamp token IDs to valid range and replace invalid values
+    output_ids = output_ids.clone()
+    
+    # Find invalid token IDs (negative or >= vocab_size)
+    invalid_mask = (output_ids < 0) | (output_ids >= vocab_size)
+    if invalid_mask.any():
+        num_invalid = invalid_mask.sum().item()
+        print(f"WARNING: Found {num_invalid} invalid token IDs, replacing with pad_token_id")
+        output_ids = torch.where(invalid_mask, torch.tensor(pad_token_id, device=output_ids.device), output_ids)
+    
+    try:
+        return tokenizer.batch_decode(output_ids, skip_special_tokens=skip_special_tokens)
+    except (OverflowError, ValueError, RuntimeError) as e:
+        print(f"WARNING: batch_decode failed with {type(e).__name__}: {e}")
+        print("Falling back to per-sequence decode...")
+        
+        # Fall back to decoding each sequence individually with error handling
+        results = []
+        for seq_ids in output_ids:
+            try:
+                text = tokenizer.decode(seq_ids, skip_special_tokens=skip_special_tokens)
+                results.append(text)
+            except Exception as seq_e:
+                print(f"WARNING: Per-sequence decode failed, returning empty string: {seq_e}")
+                results.append("")
+        return results
+
 
