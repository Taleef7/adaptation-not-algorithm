+#!/bin/bash
+# Same as merge_test_cases.sh plus the environment setup used by the other step scripts.
+# merge_test_cases.sh assumes an already-activated shell; under `sbatch --wrap` there is none, so the
+# environment is activated here, as in the other step scripts
+# (generate_test_cases.sh, generate_completions.sh, evaluate_completions.sh).
+module --force purge
+module load external
+module load anaconda
+source /opt/rh/devtoolset-10/enable
+conda activate harmbench_env
+export PYTHONNOUSERSITE=1  # keep user site-packages out of the job environment
+
+python -u merge_test_cases.py --method_name "$1" --save_dir "$2"
