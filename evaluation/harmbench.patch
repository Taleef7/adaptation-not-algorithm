+#!/bin/bash
+# Submit Llama Guard evaluations for DeepInception on JBB dataset
+# Jobs run in PARALLEL within the submission (checking dependencies vs parallel)
+
+PROJECT_ROOT="${PROJECT_ROOT}"
+HARMBENCH_ROOT="${PROJECT_ROOT}/toolkits/HarmBench"
+JBB_BEHAVIORS="${HARMBENCH_ROOT}/data/behavior_datasets/jbb_behaviors.csv"
+MODEL_PATH="${PROJECT_ROOT}/models/llama-guard-3-8b"
+
+cd "$HARMBENCH_ROOT"
+
+# Models for DeepInception (note: missing "_custom" suffix in directory names)
+MODELS=(
+    "gemma2_base_fp16" "gemma2_base_4bit" "gemma2_lora" "gemma2_qlora" "gemma2_fft"
+    "llama31_base_fp16" "llama31_base_4bit" "llama31_lora" "llama31_qlora" "llama31_fft"
+    "qwen3_base_fp16" "qwen3_base_4bit" "qwen3_lora" "qwen3_qlora" "qwen3_fft"
+    "phi4_base_fp16" "phi4_base_4bit" "phi4_lora" "phi4_qlora" "phi4_fft"
+)
+
+ATTACK="DeepInception" # Corresponds to JBB dataset here
+submitted=0
+
+echo "=============================================="
+echo "Submitting Llama Guard evals for JBB DeepInception"
+echo "Models: ${#MODELS[@]}"
+echo "=============================================="
+
+for model in "${MODELS[@]}"; do
+    # Note: Using 'results' instead of 'completions' based on file location found
+    # Input: results/DeepInception/{model}/results/{model}.json
+    COMPLETIONS="${HARMBENCH_ROOT}/results/${ATTACK}/${model}/results/${model}.json"
+    
+    # Save to: results_jbb/DeepInception/{model}_custom/results_llamaguard/{model}_custom.json
+    # (Restoring _custom suffix for consistency with other JBB results)
+    MODEL_CUSTOM="${model}_custom"
+    SAVE_PATH="${HARMBENCH_ROOT}/results_jbb/${ATTACK}/${MODEL_CUSTOM}/results_llamaguard/${MODEL_CUSTOM}.json"
+    LOG_DIR="${HARMBENCH_ROOT}/slurm_logs_jbb/evaluate_completions_llamaguard/${ATTACK}/${MODEL_CUSTOM}"
+    
+    mkdir -p "$LOG_DIR" "$(dirname $SAVE_PATH)"
+    rm -f "${LOG_DIR}/${MODEL_CUSTOM}.log"
+    
+    # Check if completions file exists
+    if [ ! -f "$COMPLETIONS" ]; then
+        echo "  [SKIP] ${model}: Completions not found at $COMPLETIONS"
+        continue
+    fi
+    
+    WRAP_CMD="module load external anaconda && conda activate harmbench_env && python evaluate_completions_llamaguard.py --behaviors_path '$JBB_BEHAVIORS' --completions_path '$COMPLETIONS' --save_path '$SAVE_PATH' --model_path '$MODEL_PATH' --num_tokens 512"
+    
+    # Use v100 partition
+    output=$(sbatch --partition=v100 --account=YOUR_ACCOUNT --qos=standby --nodes=1 --gres=gpu:1 --mem=32G --time=2:00:00 --job-name="LG-DI-J-${model:0:6}" --output="${LOG_DIR}/${MODEL_CUSTOM}.log" --error="${LOG_DIR}/${MODEL_CUSTOM}.log" --wrap="$WRAP_CMD" 2>&1)
+    
+    if [[ $output =~ Submitted\ batch\ job\ ([0-9]+) ]]; then
+        : $((submitted++))
+        echo "  [$submitted/${#MODELS[@]}] ${model} -> ${MODEL_CUSTOM} (ID: ${BASH_REMATCH[1]})"
+    else
+        echo "  [ERROR] ${model}: $output"
+    fi
+done
+
+echo ""
+echo "=============================================="
+echo "Total submitted: $submitted jobs"
+echo "=============================================="
