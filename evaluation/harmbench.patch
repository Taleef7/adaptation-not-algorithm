+++ b/scripts/submit_sequential_all_80.sh
@@ -0,0 +1,121 @@
+#!/bin/bash
+
+# Configuration
+PROJECT_ROOT="${PROJECT_ROOT}"
+HARMBENCH_ROOT="${PROJECT_ROOT}/toolkits/HarmBench"
+HB_BEHAVIORS="${HARMBENCH_ROOT}/data/behavior_datasets/harmbench_behaviors_text_all.csv"
+JBB_BEHAVIORS="${HARMBENCH_ROOT}/data/behavior_datasets/jbb_behaviors.csv"
+JOB_SCRIPT="${HARMBENCH_ROOT}/scripts/evaluate_attacks_api.sh"
+
+# Load API key
+export $(grep -v '^#' "${PROJECT_ROOT}/.env" | xargs)
+
+cd "$HARMBENCH_ROOT"
+
+MODELS=(
+    "gemma2_base_fp16_custom" "gemma2_base_4bit_custom" "gemma2_lora_custom" "gemma2_qlora_custom" "gemma2_fft_custom"
+    "llama31_base_fp16_custom" "llama31_base_4bit_custom" "llama31_lora_custom" "llama31_qlora_custom" "llama31_fft_custom"
+    "qwen3_base_fp16_custom" "qwen3_base_4bit_custom" "qwen3_lora_custom" "qwen3_qlora_custom" "qwen3_fft_custom"
+    "phi4_base_fp16_custom" "phi4_base_4bit_custom" "phi4_lora_custom" "phi4_qlora_custom" "phi4_fft_custom"
+)
+
+# Initialize dependency tracker
+LAST_JOB_ID=""
+submitted=0
+
+echo "=========================================="
+echo "Submitting 80 re-evaluation jobs SEQUENTIALLY"
+echo "Order: JBB-AD -> HB-AD -> JBB-AP -> HB-AP"
+echo "=========================================="
+
+
+# Function to submit a job
+submit_job() {
+    local job_name=$1
+    local log_out=$2
+    local log_err=$3
+    local time_limit=$4
+    local cmd_to_run=$5
+    
+    # Construct dependency string
+    local dep_cmd=""
+    if [ ! -z "$LAST_JOB_ID" ]; then
+        dep_cmd="--dependency=afterany:$LAST_JOB_ID"
+    fi
+    
+    # Submit
+    output=$(sbatch $dep_cmd --partition=a30 --account=YOUR_ACCOUNT --qos=standby --nodes=1 --gres=gpu:1 --mem=8G --time=$time_limit --job-name=$job_name --output="$log_out" --error="$log_err" --wrap="$cmd_to_run" 2>&1)
+    
+    if [[ $output =~ Submitted\ batch\ job\ ([0-9]+) ]]; then
+        LAST_JOB_ID="${BASH_REMATCH[1]}"
+        echo "[$((submitted+1))/80] Submitted $job_name (ID: $LAST_JOB_ID) -> Dependent on previous"
+        : $((submitted++))
+    else
+        echo "Error submitting $job_name: $output"
+        exit 1
+    fi
+}
+
+# --- 1. JBB AutoDAN ---
+echo ""
+echo "--- 1. JBB AutoDAN ---"
+for model in "${MODELS[@]}"; do
+    COMPLETIONS="${HARMBENCH_ROOT}/results_jbb/AutoDAN/${model}/completions/completions.json"
+    SAVE_PATH="${HARMBENCH_ROOT}/results_jbb/AutoDAN/${model}/results_api/results.json"
+    LOG_DIR="${HARMBENCH_ROOT}/slurm_logs_jbb/evaluate_completions_api/AutoDAN/${model}"
+    mkdir -p "$LOG_DIR" "$(dirname $SAVE_PATH)"
+    rm -f "${LOG_DIR}/${model}.log"
+    
+    WRAP_CMD="module load external anaconda && conda activate harmbench_env && python evaluate_attacks_api.py --behaviors_path '$JBB_BEHAVIORS' --completions_path '$COMPLETIONS' --save_path '$SAVE_PATH' --num_tokens 512"
+    
+    submit_job "JBB-AD-${model:0:8}" "${LOG_DIR}/${model}.log" "${LOG_DIR}/${model}.log" "1:00:00" "$WRAP_CMD"
+done
+
+# --- 2. HarmBench AutoDAN ---
+echo ""
+echo "--- 2. HarmBench AutoDAN ---"
+for model in "${MODELS[@]}"; do
+    COMPLETIONS="${HARMBENCH_ROOT}/results/AutoDAN/${model}/completions/${model}.json"
+    SAVE_PATH="${HARMBENCH_ROOT}/results/AutoDAN/${model}/results_api/${model}_api_eval.json"
+    LOG_DIR="${HARMBENCH_ROOT}/slurm_logs/evaluate_completions/AutoDAN/${model}/eval_api_logs"
+    mkdir -p "$LOG_DIR" "$(dirname $SAVE_PATH)"
+    rm -f "${LOG_DIR}/eval.log" "${LOG_DIR}/eval.err"
+    
+    WRAP_CMD="module load external anaconda && conda activate harmbench_env && python evaluate_attacks_api.py --behaviors_path '$HB_BEHAVIORS' --completions_path '$COMPLETIONS' --save_path '$SAVE_PATH' --num_tokens 512"
+    
+    submit_job "HB-AD-${model:0:8}" "${LOG_DIR}/eval.log" "${LOG_DIR}/eval.err" "2:00:00" "$WRAP_CMD"
+done
+
+# --- 3. JBB ArtPrompt ---
+echo ""
+echo "--- 3. JBB ArtPrompt ---"
+for model in "${MODELS[@]}"; do
+    COMPLETIONS="${HARMBENCH_ROOT}/results_jbb/ArtPrompt/${model}/completions/${model}.json"
+    SAVE_PATH="${HARMBENCH_ROOT}/results_jbb/ArtPrompt/${model}/results_api/${model}.json"
+    LOG_DIR="${HARMBENCH_ROOT}/slurm_logs_jbb/evaluate_completions_api/ArtPrompt/${model}"
+    mkdir -p "$LOG_DIR" "$(dirname $SAVE_PATH)"
+    rm -f "${LOG_DIR}/${model}.log"
+    
+    WRAP_CMD="module load external anaconda && conda activate harmbench_env && python evaluate_attacks_api.py --behaviors_path '$JBB_BEHAVIORS' --completions_path '$COMPLETIONS' --save_path '$SAVE_PATH' --num_tokens 512"
+    
+    submit_job "JBB-AP-${model:0:8}" "${LOG_DIR}/${model}.log" "${LOG_DIR}/${model}.log" "1:00:00" "$WRAP_CMD"
+done
+
+# --- 4. HarmBench ArtPrompt ---
+echo ""
+echo "--- 4. HarmBench ArtPrompt ---"
+for model in "${MODELS[@]}"; do
+    COMPLETIONS="${HARMBENCH_ROOT}/results/ArtPrompt/${model}/completions/${model}.json"
+    SAVE_PATH="${HARMBENCH_ROOT}/results/ArtPrompt/${model}/results_api/${model}_api_eval.json"
+    LOG_DIR="${HARMBENCH_ROOT}/slurm_logs/evaluate_completions/ArtPrompt/${model}/eval_api_logs"
+    mkdir -p "$LOG_DIR" "$(dirname $SAVE_PATH)"
+    rm -f "${LOG_DIR}/eval.log" "${LOG_DIR}/eval.err"
+    
+    WRAP_CMD="module load external anaconda && conda activate harmbench_env && python evaluate_attacks_api.py --behaviors_path '$HB_BEHAVIORS' --completions_path '$COMPLETIONS' --save_path '$SAVE_PATH' --num_tokens 512"
+    
+    submit_job "HB-AP-${model:0:8}" "${LOG_DIR}/eval.log" "${LOG_DIR}/eval.err" "2:00:00" "$WRAP_CMD"
+done
+
+
+echo ""
+echo "Done! 80 jobs submitted in a single sequential chain."
