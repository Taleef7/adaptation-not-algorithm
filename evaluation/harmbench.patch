+        WRAP_CMD="module load external anaconda && conda activate harmbench_env && python evaluate_completions_llamaguard.py --behaviors_path '$JBB_BEHAVIORS' --completions_path '$COMPLETIONS' --save_path '$SAVE_PATH' --model_path '$MODEL_PATH' --num_tokens 512"
+        
+        # Use v100 partition
+        output=$(sbatch --partition=v100 --account=YOUR_ACCOUNT --qos=standby --nodes=1 --gres=gpu:1 --mem=32G --time=2:00:00 --job-name="LG-J${ATTACK:0:1}-${model:0:6}" --output="${LOG_DIR}/${model}.log" --error="${LOG_DIR}/${model}.log" --wrap="$WRAP_CMD" 2>&1)
+        
+        if [[ $output =~ Submitted\ batch\ job\ ([0-9]+) ]]; then
+            : $((submitted++))
+            echo "  [$submitted] ${model} (ID: ${BASH_REMATCH[1]})"
+        else
+            echo "  [ERROR] ${model}: $output"
+        fi
+    done
+done
+
+echo ""
+echo "=============================================="
+echo "Total submitted: $submitted jobs (running in parallel)"
+echo "=============================================="
