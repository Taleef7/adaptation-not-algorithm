+#!/bin/bash
+# Submit Llama Guard evaluations for HarmBench - DeepInception_HarmBench attack
+# Jobs run in PARALLEL (no API rate limits for local inference)
+
+PROJECT_ROOT="${PROJECT_ROOT}"
+HARMBENCH_ROOT="${PROJECT_ROOT}/toolkits/HarmBench"
+HB_BEHAVIORS="${HARMBENCH_ROOT}/data/behavior_datasets/harmbench_behaviors_text_all.csv"
+MODEL_PATH="${PROJECT_ROOT}/models/llama-guard-3-8b"
+
+cd "$HARMBENCH_ROOT"
+
+MODELS=(
+    "gemma2_base_fp16_custom" "gemma2_base_4bit_custom" "gemma2_lora_custom" "gemma2_qlora_custom" "gemma2_fft_custom"
+    "llama31_base_fp16_custom" "llama31_base_4bit_custom" "llama31_lora_custom" "llama31_qlora_custom" "llama31_fft_custom"
+    "qwen3_base_fp16_custom" "qwen3_base_4bit_custom" "qwen3_lora_custom" "qwen3_qlora_custom" "qwen3_fft_custom"
+    "phi4_base_fp16_custom" "phi4_base_4bit_custom" "phi4_lora_custom" "phi4_qlora_custom" "phi4_fft_custom"
+)
+
+ATTACK="DeepInception_HarmBench"
+submitted=0
+
+echo "=============================================="
+echo "Submitting Llama Guard evals for $ATTACK"
+echo "Models: ${#MODELS[@]}"
+echo "=============================================="
+
+for model in "${MODELS[@]}"; do
+    COMPLETIONS="${HARMBENCH_ROOT}/results/${ATTACK}/${model}/completions/${model}.json"
+    SAVE_PATH="${HARMBENCH_ROOT}/results/${ATTACK}/${model}/results_llamaguard/${model}.json"
+    LOG_DIR="${HARMBENCH_ROOT}/slurm_logs/evaluate_completions/${ATTACK}/${model}/eval_llamaguard_logs"
+    mkdir -p "$LOG_DIR" "$(dirname $SAVE_PATH)"
+    rm -f "${LOG_DIR}/${model}.log"
+    
+    # Check if completions file exists
+    if [ ! -f "$COMPLETIONS" ]; then
+        echo "  [SKIP] ${model}: Completions not found at $COMPLETIONS"
+        continue
+    fi
+    
+    WRAP_CMD="module load external anaconda && conda activate harmbench_env && python evaluate_completions_llamaguard.py --behaviors_path '$HB_BEHAVIORS' --completions_path '$COMPLETIONS' --save_path '$SAVE_PATH' --model_path '$MODEL_PATH' --num_tokens 512"
+    
+    # Use v100 partition (32GB VRAM, good for 8B model)
+    output=$(sbatch --partition=v100 --account=YOUR_ACCOUNT --qos=standby --nodes=1 --gres=gpu:1 --mem=32G --time=2:00:00 --job-name="LG-DI-${model:0:6}" --output="${LOG_DIR}/${model}.log" --error="${LOG_DIR}/${model}.log" --wrap="$WRAP_CMD" 2>&1)
+    
+    if [[ $output =~ Submitted\ batch\ job\ ([0-9]+) ]]; then
+        : $((submitted++))
+        echo "  [$submitted/${#MODELS[@]}] ${model} (ID: ${BASH_REMATCH[1]})"
+    else
+        echo "  [ERROR] ${model}: $output"
+    fi
+done
+
+echo ""
+echo "=============================================="
+echo "Total submitted: $submitted jobs (running in parallel)"
+echo "=============================================="
