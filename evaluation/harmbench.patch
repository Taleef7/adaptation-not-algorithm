+#!/bin/bash
+#===============================================================================
+# GPT-4o-mini Evaluation for DeepInception-HarmBench Completions
+# Methodology matches original DeepInception/JBB evaluation for research consistency
+#
+# Features:
+# - JSON response format with is_jailbroken and refusal_type
+# - 512 token clipping with gpt2 tokenizer
+# - Same judge prompt structure as original evaluation/evaluate_responses.py
+#===============================================================================
+
+# Configuration
+HARMBENCH_ROOT="${PROJECT_ROOT}/toolkits/HarmBench"
+BEHAVIORS_PATH="${HARMBENCH_ROOT}/data/behavior_datasets/harmbench_behaviors_text_all.csv"
+RESULTS_BASE="${HARMBENCH_ROOT}/results/DeepInception_HarmBench"
+LOG_DIR="${HARMBENCH_ROOT}/slurm_logs/DeepInception_HarmBench/evaluate_api"
+SCRIPT="${HARMBENCH_ROOT}/evaluate_deepinception_harmbench_api.py"
+
+# All 20 model configurations
+MODELS=(
+    "gemma2_base_fp16_custom"
+    "gemma2_base_4bit_custom"
+    "gemma2_fft_custom"
+    "gemma2_lora_custom"
+    "gemma2_qlora_custom"
+    "llama31_base_fp16_custom"
+    "llama31_base_4bit_custom"
+    "llama31_fft_custom"
+    "llama31_lora_custom"
+    "llama31_qlora_custom"
+    "qwen3_base_fp16_custom"
+    "qwen3_base_4bit_custom"
+    "qwen3_fft_custom"
+    "qwen3_lora_custom"
+    "qwen3_qlora_custom"
+    "phi4_base_fp16_custom"
+    "phi4_base_4bit_custom"
+    "phi4_fft_custom"
+    "phi4_lora_custom"
+    "phi4_qlora_custom"
+)
+
+# Create log directory
+mkdir -p "${LOG_DIR}"
+
+echo "=============================================="
+echo "DeepInception-HarmBench GPT-4o-mini Evaluation"
+echo "=============================================="
+echo "Models to evaluate: ${#MODELS[@]}"
+echo "Behaviors path: ${BEHAVIORS_PATH}"
+echo "Results base: ${RESULTS_BASE}"
+echo "Log directory: ${LOG_DIR}"
+echo ""
+
+# Submit jobs
+SUBMITTED=0
+SKIPPED=0
+
+for MODEL in "${MODELS[@]}"; do
+    COMPLETIONS_PATH="${RESULTS_BASE}/${MODEL}/completions/${MODEL}.json"
+    SAVE_PATH="${RESULTS_BASE}/${MODEL}/results_api/${MODEL}_api.json"
+    
+    # Check if completions exist
+    if [ ! -f "${COMPLETIONS_PATH}" ]; then
+        echo "[SKIP] ${MODEL}: Completions not found"
+        ((SKIPPED++))
+        continue
+    fi
+    
+    # Check if results already exist
+    if [ -f "${SAVE_PATH}" ]; then
+        echo "[SKIP] ${MODEL}: Results already exist"
+        ((SKIPPED++))
+        continue
+    fi
+    
+    echo "[SUBMIT] ${MODEL}"
+    
+    # Create results directory
+    mkdir -p "$(dirname ${SAVE_PATH})"
+    
+    # Submit SLURM job - requires GPU allocation even for API-only jobs on this cluster
+    sbatch <<EOF
+#!/bin/bash
+#SBATCH --job-name=eval_api_${MODEL}
+#SBATCH --account=YOUR_ACCOUNT
+#SBATCH --partition=a30
+#SBATCH --qos=standby
+#SBATCH --time=04:00:00
+#SBATCH --nodes=1
+#SBATCH --ntasks=1
+#SBATCH --cpus-per-task=4
+#SBATCH --mem=16G
+#SBATCH --gres=gpu:1
+#SBATCH --output=${LOG_DIR}/${MODEL}.log
+#SBATCH --error=${LOG_DIR}/${MODEL}.log
+
+echo "=============================================="
+echo "GPT-4o-mini Evaluation: ${MODEL}"
+echo "=============================================="
+echo "Start time: \$(date)"
+echo "Node: \$(hostname)"
+echo ""
+
+# Load environment
+module purge
+module load external
+module load anaconda
+conda activate harmbench_env
+
+cd ${HARMBENCH_ROOT}
+
+# Run evaluation
+python ${SCRIPT} \\
+    --behaviors_path "${BEHAVIORS_PATH}" \\
+    --completions_path "${COMPLETIONS_PATH}" \\
+    --save_path "${SAVE_PATH}" \\
+    --num_tokens 512
+
+echo ""
+echo "End time: \$(date)"
+echo "=============================================="
+EOF
+
+    ((SUBMITTED++))
+    
+    # Small delay between submissions
+    sleep 0.5
+done
+
+echo ""
+echo "=============================================="
+echo "Summary"
+echo "=============================================="
+echo "Submitted: ${SUBMITTED}"
+echo "Skipped: ${SKIPPED}"
+echo ""
+echo "Monitor jobs: squeue -u \$USER | grep eval_api"
+echo "Check logs: tail -f ${LOG_DIR}/*.log"
diff --git a/scripts/run_or_bench_evaluation.sh b/scripts/run_or_bench_evaluation.sh
new file mode 100755
index 0000000..332b7cd
--- /dev/null
+++ b/scripts/run_or_bench_evaluation.sh
@@ -0,0 +1,207 @@
+#!/bin/bash
+
+set -euo pipefail
+
+export OR_BENCH_API_MAX_RETRY="${OR_BENCH_API_MAX_RETRY:-12}"
+export OR_BENCH_API_RETRY_SLEEP="${OR_BENCH_API_RETRY_SLEEP:-20}"
+export OR_BENCH_API_TIMEOUT="${OR_BENCH_API_TIMEOUT:-180}"
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+HARMBENCH_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
+REPO_ROOT="$(cd "${HARMBENCH_DIR}/../.." && pwd)"
+
+MODELS=(
+    "gemma2_base_fp16_custom"
+    "gemma2_base_4bit_custom"
+    "gemma2_lora_custom"
+    "gemma2_qlora_custom"
+    "gemma2_fft_custom"
+    "llama31_base_fp16_custom"
+    "llama31_base_4bit_custom"
+    "llama31_lora_custom"
+    "llama31_qlora_custom"
+    "llama31_fft_custom"
+    "phi4_base_fp16_custom"
+    "phi4_base_4bit_custom"
+    "phi4_lora_custom"
+    "phi4_qlora_custom"
+    "phi4_fft_custom"
+    "qwen25_14b_base_fp16_custom"
+    "qwen25_14b_base_4bit_custom"
+    "qwen25_14b_lora_custom"
+    "qwen25_14b_qlora_custom"
+    "qwen25_14b_fft_custom"
+    "qwen3_base_fp16_custom"
+    "qwen3_base_4bit_custom"
+    "qwen3_lora_custom"
+    "qwen3_qlora_custom"
+    "qwen3_fft_custom"
+)
+
+DATA_DIR="${HARMBENCH_DIR}/data/behavior_datasets/or_bench"
+HARD_1K_BEHAVIORS="${DATA_DIR}/or_bench_hard_1k.csv"
+TOXIC_BEHAVIORS="${DATA_DIR}/or_bench_toxic.csv"
+
+RESULTS_ROOT="${HARMBENCH_DIR}/results/ORBench"
+HARD_1K_COMPLETIONS_DIR="${RESULTS_ROOT}/Hard-1K/DirectRequest/default/completions"
+HARD_1K_RESULTS_DIR="${RESULTS_ROOT}/Hard-1K/DirectRequest/default/results"
+TOXIC_COMPLETIONS_DIR="${RESULTS_ROOT}/Toxic/DirectRequest/default/completions"
+TOXIC_RESULTS_DIR="${RESULTS_ROOT}/Toxic/DirectRequest/default/results"
+
+MODE="${1:-}"
+SUBSET="${2:-all}"
+
+if [[ -z "${MODE}" ]]; then
+    echo "Usage: $0 {download|generate|evaluate|compile|check} [hard_1k|toxic|all]"
+    exit 1
+fi
+
+filter_models() {
+    local selected=()
+    if [[ -n "${MODELS_FILTER:-}" ]]; then
+        for model in "${MODELS[@]}"; do
+            if [[ "${model}" == *"${MODELS_FILTER}"* ]]; then
+                selected+=("${model}")
+            fi
+        done
+    else
+        selected=("${MODELS[@]}")
+    fi
+    printf '%s\n' "${selected[@]}"
+}
+
+run_generation() {
+    local subset_name="$1"
+    local behaviors_path="$2"
+    local completions_dir="$3"
+
+    mkdir -p "${completions_dir}"
+    while IFS= read -r model; do
+        [[ -z "${model}" ]] && continue
+        echo "Generating ${subset_name} completions for ${model}"
+        (
+            cd "${HARMBENCH_DIR}"
+            python generate_completions.py \
+                --model_name "${model}" \
+                --behaviors_path "${behaviors_path}" \
+                --save_path "${completions_dir}/${model}.json" \
+                --max_new_tokens 512 \
+                --incremental_update
+        )
+    done < <(filter_models)
+}
+
+run_evaluation() {
+    local subset_name="$1"
+    local prompt_type="$2"
+    local behaviors_path="$3"
+    local completions_dir="$4"
+    local results_dir="$5"
+
+    mkdir -p "${results_dir}"
+    while IFS= read -r model; do
+        [[ -z "${model}" ]] && continue
+        local completions_path="${completions_dir}/${model}.json"
+        if [[ ! -f "${completions_path}" ]]; then
+            echo "Skipping ${model}; completions missing at ${completions_path}"
+            continue
+        fi
+        echo "Evaluating ${subset_name} OR-Bench responses for ${model}"
+        (
+            cd "${HARMBENCH_DIR}"
+            python evaluate_or_bench.py \
+                --behaviors_path "${behaviors_path}" \
+                --completions_path "${completions_path}" \
+                --save_path "${results_dir}/${model}.json" \
+                --subset_name "${subset_name}" \
+                --prompt_type "${prompt_type}" \
+                --judge_model "${OR_BENCH_JUDGE_MODEL:-gpt-4o-mini}" \
+                --incremental_update
+        )
+    done < <(filter_models)
+}
+
+check_subset() {
+    local subset_name="$1"
+    local completions_dir="$2"
+    local results_dir="$3"
+
+    echo "=== ${subset_name} ==="
+    while IFS= read -r model; do
+        [[ -z "${model}" ]] && continue
+        local completion_mark="missing"
+        local result_mark="missing"
+        [[ -f "${completions_dir}/${model}.json" ]] && completion_mark="ok"
+        [[ -f "${results_dir}/${model}.json" ]] && result_mark="ok"
+        printf '%-36s completions=%-7s results=%-7s\n' "${model}" "${completion_mark}" "${result_mark}"
+    done < <(filter_models)
+}
+
+case "${MODE}" in
+    download)
+        cd "${REPO_ROOT}"
+        python scripts/or_bench/download_or_bench.py
+        ;;
+    generate)
+        case "${SUBSET}" in
+            hard_1k)
+                run_generation "Hard-1K" "${HARD_1K_BEHAVIORS}" "${HARD_1K_COMPLETIONS_DIR}"
+                ;;
+            toxic)
+                run_generation "Toxic" "${TOXIC_BEHAVIORS}" "${TOXIC_COMPLETIONS_DIR}"
+                ;;
+            all)
+                run_generation "Hard-1K" "${HARD_1K_BEHAVIORS}" "${HARD_1K_COMPLETIONS_DIR}"
+                run_generation "Toxic" "${TOXIC_BEHAVIORS}" "${TOXIC_COMPLETIONS_DIR}"
+                ;;
+            *)
+                echo "Unknown subset: ${SUBSET}"
+                exit 1
+                ;;
+        esac
+        ;;
+    evaluate)
