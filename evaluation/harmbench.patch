+#!/bin/bash
+
+# Submit all DeepInception Llama-2 evaluation jobs
+# This script submits 20 evaluation jobs (one per model configuration)
+
+echo "=========================================="
+echo "Submitting DeepInception Llama-2 Evaluations"
+echo "=========================================="
+echo ""
+
+# Get script directory
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+SLURM_SCRIPT="$SCRIPT_DIR/evaluate_deepinception_llama2.slurm"
+
+# Check if slurm script exists
+if [ ! -f "$SLURM_SCRIPT" ]; then
+    echo "ERROR: SLURM script not found: $SLURM_SCRIPT"
+    exit 1
+fi
+
+# Create log directory
+mkdir -p "$SCRIPT_DIR/../slurm_logs/evaluate_completions/DeepInception"
+
+# Model names for display
+MODELS=(
+    "gemma2_base_fp16"
+    "gemma2_base_4bit"
+    "gemma2_lora"
+    "gemma2_qlora"
+    "gemma2_fft"
+    "llama31_base_fp16"
+    "llama31_base_4bit"
+    "llama31_lora"
+    "llama31_qlora"
+    "llama31_fft"
+    "phi4_base_fp16"
+    "phi4_base_4bit"
+    "phi4_lora"
+    "phi4_qlora"
+    "phi4_fft"
+    "qwen3_base_fp16"
+    "qwen3_base_4bit"
+    "qwen3_lora"
+    "qwen3_qlora"
+    "qwen3_fft"
+)
+
+# Submit jobs
+echo "Submitting 20 evaluation jobs..."
+echo ""
+
+JOB_IDS=()
+
+for i in {0..19}; do
+    MODEL_NAME="${MODELS[$i]}"
+    
+    # Submit job
+    JOB_OUTPUT=$(sbatch --job-name="eval_di_llama2_${MODEL_NAME}" "$SLURM_SCRIPT" $i)
+    JOB_ID=$(echo "$JOB_OUTPUT" | grep -oP '\d+')
+    
+    if [ -n "$JOB_ID" ]; then
+        echo "✓ Submitted: ${MODEL_NAME} (Job ID: $JOB_ID)"
+        JOB_IDS+=($JOB_ID)
+    else
+        echo "✗ Failed: ${MODEL_NAME}"
+    fi
+done
+
+echo ""
+echo "=========================================="
+echo "Submission Complete"
+echo "=========================================="
+echo ""
+echo "Submitted ${#JOB_IDS[@]}/20 jobs"
+echo ""
+echo "Job IDs: ${JOB_IDS[@]}"
+echo ""
+echo "Monitor progress with:"
+echo "  squeue -u \$USER"
+echo ""
+echo "Check logs in:"
+echo "  toolkits/HarmBench/slurm_logs/evaluate_completions/DeepInception/"
+echo ""
+echo "Results will be saved to:"
+echo "  toolkits/HarmBench/results/DeepInception/{MODEL_NAME}/results/"
+echo ""
