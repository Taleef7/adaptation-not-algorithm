+++ b/scripts/merge_completions_custom.py
@@ -0,0 +1,103 @@
+import os
+import json
+import argparse
+import glob
+from tqdm import tqdm
+
+def merge_completions(method, model, harmbench_root):
+    results_dir = os.path.join(harmbench_root, "results", method, model)
+    behaviors_dir = os.path.join(results_dir, "test_cases", "test_cases_individual_behaviors")
+    output_dir = os.path.join(results_dir, "completions")
+    output_file = os.path.join(output_dir, f"{model}.json")
+
+    print(f"Merging completions for {method} - {model}...")
+    print(f"Source: {behaviors_dir}")
+
+    if not os.path.exists(behaviors_dir):
+        print(f"Error: Behaviors directory not found: {behaviors_dir}")
+        return
+
+    merged_data = {}
+
+    # Iterate over behavior directories
+    behavior_dirs = glob.glob(os.path.join(behaviors_dir, "*"))
+    for behavior_path in tqdm(behavior_dirs):
+        if not os.path.isdir(behavior_path):
+            continue
+        
+        behavior_id = os.path.basename(behavior_path)
+        
+        # Look for the JSON file containing generations
+        # AutoDAN/ArtPrompt often save to 'test_cases.json' or 'generations.json'
+        # We need to find the one that has the 'generation' field.
+        
+        found = False
+        potential_files = ["test_cases.json", "generations.json", "logs.json"]
+        
+        for fname in potential_files:
+            fpath = os.path.join(behavior_path, fname)
+            if os.path.exists(fpath):
+                try:
+                    with open(fpath, 'r') as f:
+                        data = json.load(f)
+                        
+                    # Check structure
+                    # Expected: { behavior_id: [ list of items ] } or direct list
+                    # Item expected: { 'generation': ..., 'test_case': ... }
+                    
+                    # Handle dictionary with behavior_id key
+                    if isinstance(data, dict):
+                        if behavior_id in data:
+                            items = data[behavior_id]
+                        else:
+                            # Sometimes keys match but maybe slightly different, or it's a flat dict
+                            # If only one key, take it
+                            keys = list(data.keys())
+                            if len(keys) == 1:
+                                items = data[keys[0]]
+                            else:
+                                continue 
+                    elif isinstance(data, list):
+                        items = data
+                    else:
+                        continue
+
+                    # Check if items have 'generation'
+                    if isinstance(items, list) and len(items) > 0:
+                        # Check first item
+                        if isinstance(items[0], str):
+                             # This is just a list of strings (prompts), likely Step 1 output
+                             continue
+                        if isinstance(items[0], dict):
+                            if 'generation' in items[0]:
+                                merged_data[behavior_id] = items
+                                found = True
+                                break
+                except Exception as e:
+                    print(f"Error reading {fpath}: {e}")
+
+    if not merged_data:
+        print(f"Warning: No valid completions found for {model}")
+        return
+
+    # Save merged data
+    os.makedirs(output_dir, exist_ok=True)
+    with open(output_file, 'w') as f:
+        json.dump(merged_data, f, indent=4)
+    
+    print(f"Saved merged completions to: {output_file}")
+    print(f"Total behaviors: {len(merged_data)}")
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--method", type=str, required=True, help="Attack method (AutoDAN, ArtPrompt)")
+    parser.add_argument("--models", type=str, required=True, help="Comma-separated list of models")
+    parser.add_argument("--harmbench_root", type=str, default="${PROJECT_ROOT}/toolkits/HarmBench")
+    args = parser.parse_args()
+
+    models = args.models.split(",")
+    for model in models:
+        merge_completions(args.method, model, args.harmbench_root)
+
+if __name__ == "__main__":
+    main()
