+#!/usr/bin/env python3
+"""
+Download Llama Guard 3-8B model from Hugging Face.
+Saves to ${PROJECT_ROOT}/models/llama-guard-3-8b/
+
+Requirements:
+- huggingface_hub
+- transformers
+- You must be logged in to Hugging Face and have accepted the Llama Guard license
+
+Usage:
+    python download_llama_guard.py
+"""
+
+import os
+from huggingface_hub import snapshot_download
+from transformers import AutoTokenizer, AutoModelForCausalLM
+
+MODEL_ID = "meta-llama/Llama-Guard-3-8B"
+SAVE_PATH = "${PROJECT_ROOT}/models/llama-guard-3-8b"
+
+def main():
+    print(f"Downloading {MODEL_ID} to {SAVE_PATH}...")
+    
+    # Create directory if it doesn't exist
+    os.makedirs(SAVE_PATH, exist_ok=True)
+    
+    # Download model files
+    snapshot_download(
+        repo_id=MODEL_ID,
+        local_dir=SAVE_PATH,
+        local_dir_use_symlinks=False,
+        resume_download=True
+    )
+    
+    print(f"Model downloaded to {SAVE_PATH}")
+    
+    # Verify the model loads correctly
+    print("Verifying model loads...")
+    tokenizer = AutoTokenizer.from_pretrained(SAVE_PATH)
+    print(f"Tokenizer loaded: {tokenizer.__class__.__name__}")
+    
+    print("Download complete! Model is ready to use.")
+
+if __name__ == "__main__":
+    main()
